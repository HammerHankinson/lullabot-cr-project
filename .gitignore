# Ignore dependencies.
/vendor/
/drush/Commands/contrib/
/web/core/
/web/libraries/
/web/modules/contrib/
/web/profiles/contrib/
/web/themes/contrib/

# Ignore paths that contain user-generated content.
web/files
web/sites/*/files
web/sites/*/private

# Ignore local settings information
/web/sites/*/settings.local.php

# Ignore files generated by PhpStorm
/.idea/

# Ignore files generated by VS Code
/.vscode/

# Ignore .env files as they are personal
/.env
/.env.defaults

# Test artifacts.
/test_result/
/.twig-cs-fixer.cache
/.task/

.DS_Store

/.twig-cs-fixer.dist.php
/phpstan.neon.dist
